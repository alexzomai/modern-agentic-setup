{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.10.1"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@4.21.4", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"]
    },
    "postgres": {
      "command": "uvx",
      "args": ["postgres-mcp@0.3.0", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${DATABASE_URI:-postgresql://postgres@localhost:5432/postgres}"
      }
    }
  }
}
