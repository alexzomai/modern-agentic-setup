# Скопируйте в .env и заполните. Не коммитьте .env.
# Агенты не читают .env сами: переменные должны быть в окружении shell,
# из которого запускается агент (например, `set -a; source .env; set +a` или direnv).

# Строка подключения для MCP-сервера postgres (см. .mcp.json, opencode.json, .codex/config.toml)
DATABASE_URI=postgresql://user:password@localhost:5432/dbname
